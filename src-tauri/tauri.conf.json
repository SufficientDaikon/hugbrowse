{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HugBrowse",
  "version": "0.1.0",
  "identifier": "com.hugbrowse.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "plugins": {
    "shell": {
      "open": "^https://",
      "scope": [
        {
          "name": "llama-server",
          "sidecar": true
        }
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "HugBrowse — Model Hub Browser",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://huggingface.co https://*.huggingface.co http://127.0.0.1:*; img-src 'self' https://huggingface.co https://*.huggingface.co https://cdn-avatars.huggingface.co data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/llama-server"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
